# LLM provider: groq (default) or gemini.
LLM_PROVIDER=groq

# Groq API key (https://console.groq.com/keys). Optional per-agent-group keys
# GROQ_API_KEY_<GROUP> (ANALYSIS, COMPARISON, GAP, VALIDATION, CRITIC, QUESTION)
# override it. Groq rate limits apply per organization, not per key.
GROQ_API_KEY=

# Optional model overrides: GROQ_MODEL_<ROLE> or GROQ_MODEL for all roles.
# Roles: PLANNER, ANALYSIS, COMPARISON, GAP, VALIDATION, CRITIC, QUESTION, BASELINE.
# Defaults: PLANNER, ANALYSIS, VALIDATION -> openai/gpt-oss-20b;
# GAP, CRITIC, QUESTION, BASELINE -> openai/gpt-oss-120b. COMPARISON is used only
# by the legacy LLM comparison (COMPARISON_MODE=llm).
# GROQ_MODEL_CRITIC=openai/gpt-oss-120b
# Optional reasoning effort for openai/gpt-oss models: low, medium or high.
# GROQ_REASONING_EFFORT=medium

# Tokens-per-minute budget. Requests are sized (input + completion cap) and
# paced to stay within it; oversized requests are refused before sending.
# Default 8000 (Groq base limit for openai/gpt-oss-*); 0 disables. Set your
# organization's real limit, globally or per model:
# GROQ_TPM_LIMIT=8000
# GROQ_TPM_LIMIT_OPENAI_GPT_OSS_120B=8000
# GROQ_MAX_COMPLETION_TOKENS=4096

# Fixed output budget per LLM task (visible JSON + reasoning tokens). A request
# whose input plus this budget exceeds the TPM budget is refused before sending.
# Defaults live in src/agents/output_budget.py; override per task, e.g.:
# LLM_OUTPUT_BUDGET_GAP_DETECTION=3072
# LLM_OUTPUT_BUDGET_EVIDENCE_GAP=3072
# LLM_OUTPUT_BUDGET_CRITIC_VERDICT=2048

# Optional daily limits from your Groq console (Settings -> Limits). Used only by
# the dry-run report (--dry-run) to show the share of your daily quota a run needs.
# Without them the dry run assumes the free tier: 200000 tokens and 1000 requests
# per day for each openai/gpt-oss-* model.
# GROQ_TPD_LIMIT_OPENAI_GPT_OSS_120B=
# GROQ_RPD_LIMIT_OPENAI_GPT_OSS_120B=

# Cross-paper comparison: matrix (default; deterministic evidence matrix, no LLM
# call) or llm (legacy LLM comparison).
# COMPARISON_MODE=matrix
# Evidence-matrix thresholds (cosine, local bge-small-en-v1.5 embeddings).
# EVIDENCE_MATRIX_SIMILARITY_THRESHOLD=0.70
# EVIDENCE_MATRIX_GROUNDING_THRESHOLD=0.55

# ---- Optional Gemini provider (LLM_PROVIDER=gemini) ----
# Optional model overrides: GEMINI_MODEL_<ROLE> or GEMINI_MODEL.
# Final fallback used when neither the new nor corresponding previous key exists.
GEMINI_API_KEY=

# Six independent project keys (one per agent group).
GEMINI_API_KEY_ANALYSIS=
GEMINI_API_KEY_COMPARISON=
GEMINI_API_KEY_GAP=
GEMINI_API_KEY_VALIDATION=
GEMINI_API_KEY_CRITIC=
GEMINI_API_KEY_QUESTION=

# Previous four-key names remain supported as intermediate fallbacks.
GEMINI_API_KEY_COMPARISON_GAP=
GEMINI_API_KEY_VALIDATION_CRITIC=
